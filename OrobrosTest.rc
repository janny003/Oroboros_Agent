#include "resource.h"
#include "afxres.h"

IDD_OROBROSTEST_DIALOG DIALOGEX 0, 0, 760, 470
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "OrobrosTest"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Command",IDC_STATIC_CMD,10,12,55,10
    EDITTEXT        IDC_EDIT_COMMAND,70,10,500,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Start",IDC_BUTTON_START,580,8,45,18
    PUSHBUTTON      "Load Log",IDC_BUTTON_LOAD_LOG,630,8,65,18
    PUSHBUTTON      "Stop",IDC_BUTTON_STOP,700,8,50,18
    LTEXT           "Initial Context",IDC_STATIC_CONTEXT,10,36,55,10
    EDITTEXT        IDC_EDIT_CONTEXT,70,34,680,28,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Agent Status",IDC_STATIC_AGENT_STATUS_LABEL,10,70,70,10
    LTEXT           "Idle - Press Start to run.",IDC_STATIC_AGENT_STATUS,85,68,665,18,SS_SUNKEN
    CONTROL         "",IDC_LIST_AGENT_PROGRESS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,92,740,98
    EDITTEXT        IDC_EDIT_TRANSCRIPT,10,198,740,202,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    LTEXT           "Answer",IDC_STATIC_ANSWER,10,414,45,10
    EDITTEXT        IDC_EDIT_ANSWER,70,410,570,36,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Send",IDC_BUTTON_SEND,650,414,100,28
END
